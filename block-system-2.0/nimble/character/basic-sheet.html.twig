<div class='container-fluid sheet-nimble'>
  {% import _self as sheet %}
  {% set att = [ "str", "dex", "int", "wil" ] %}
  {% set skill_list = [
      ["arcana", "int"],
      ["examination", "int"],
      ["finesse", "dex"],
      ["influence", "wil"],
      ["insight", "wil"],
      ["lore", "int"],
      ["might", "str"],
      ["naturecraft", "wil"],
      ["perception", "wil"],
      ["stealth", "dex"]
  ] %}
  <div class='row'>
    <div class='col-12 col-md-12 c'>
        <img src="/i/7978043/render" width=350px>
    </div>
    {% set wdo = 12 %}{% set wdi = 6 %}{% set img = variables.portrait|default %}
    {% if img > 0 %}{% set wdo = 8 %}{% set wdi = 12 %}{% endif %}
    <div class='col-12 col-md-{{wdo}}'>
      <div class='row'>
        <div class='col-12 col-md-{{wdi}}'>
          <div class='card personal' id='card-personal'>
            <div class='card-body of'>
              <table class='table'>
                <tr><th class='lbl od lbl-name' width='30%'> name </th><td class='var od var-name'> {{variables.name|default}} </td></tr>
                <tr><th class='lbl ev lbl-ancestry'> ancestry </th><td class='var ev var-ancestry'> {{variables.ancestry|default}} </td></tr>
                <tr><th class='lbl od lbl-class'> class </th><td class='var od var-class'> {{variables.class|default}} </td></tr>
                <tr><th class='lbl ev lbl-level'> level </th><td class='var ev var-level'>{{variables.level|default}}</td></tr>
              </table>
            </div>
          </div>
        </div>
        <div class='col-12 col-md-{{wdi}}'>
          <div class='card personal' id='card-personal'>
            <div class='card-body of'>
              <table class='table'>
                <tr><th class='lbl od lbl-height' width='30%'> height </th><td class='var od var-height'> {{variables.height|default}} </td></tr>
                <tr><th class='lbl ev lbl-weight'> weight </th><td class='var ev var-weight'> {{variables.weight|default}} </td></tr>
                <tr><th class='lbl od lbl-speed'> speed </th><td class='var od var-speed'> {{variables.speed|default}} </td></tr>
                <tr><th class='lbl ev lbl-hit-dice-curr'> hit dice </th><td class='var ev var-hit-dice'> {{variables.hit_dice_max|default}}</td></tr>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
    {% if img > 0 %}
    <div class='col-12 col-md-4'>
      <div class='card portrait' id='card-portrait'>
        <div class='card-body of'>
          <div class='var od var-portrait'>[img:{{img}}]</div>
        </div>
      </div>
    </div>
    {% endif %}
    {% for i in 1..4 %}
      {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
      {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
      <div class='col-12 col-md-3'>
        <div class='card attributes' id='card-attributes'>
          <div class='card-header attributes'>{{att[id-1]}}</div>
          <div class='card-body of'>
            <table class='table'>
              <tr><td class='var {{eo}} var-att-value'>{{attribute(variables, 'att_value_' ~ id)|default}}</td></tr>
            </table>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
  <div class='row'>
    <div class='col-12 col-md-3'>
      <div class='card hp' id='card-hp'>
        <div class='card-body of'>
          <table class='table'>
            <tr><th class='lbl od lbl-hp-curr'> hp <i class="fa-solid fa-heart"></i></th><td class='var od var-hp-curr'>{{variables.hp_curr|default}} / {{variables.hp_max|default}}</td></tr>
          </table>
        </div>
      </div>
    </div>
    <div class='col-12 col-md-3'>
      <div class='card hp' id='card-hp'>
        <div class='card-body of'>
          <table class='table'>
            {% set hptemp = variables.hp_temp|default %}{% if hptemp == "" %}{% set hptemp = "0" %}{% endif %}
            <tr><th class='lbl od lbl-hp-temp'> hp temp <i class="fa-sharp fa-solid fa-square-plus"></i></th><td class='var od var-hp-temp'>{{hptemp}}</td></tr>
          </table>
        </div>
      </div>
    </div>
    <div class='col-12 col-md-3'>
      <div class='card ac' id='card-ac'>
        <div class='card-body of'>
          <table class='table'>
            <tr><th class='lbl od lbl-armor'> armor <i class="fa-regular fa-shield"></i></th><td class='var od var-armor'>{{variables.armor|default}}</td></tr>
          </table>
        </div>
      </div>
    </div>
    <div class='col-12 col-md-3'>
      <div class='card hp' id='card-hp'>
        <div class='card-body of'>
          <table class='table'>
            <tr><th class='lbl od lbl-ini'> initiative </th><td class='var od var-ini'> {{variables.ini|default}} </td></tr>
          </table>
        </div>
      </div>
    </div>
    <div class='col-12 col-md-12'>
      <div class='card wounds' id='card-wounds'>
        <div class='card-body of c'>
          <table class='table'>
            <tr><th class='lbl od lbl-wounds'> Wounds <i class="fa-solid fa-droplet"></i> </th><td class='var od var-wounds'>
          {% for i in 1..5 %}
            {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
            {% if attribute(variables, 'wounds_' ~ id)|default == 1 %}<i class='fa-regular fa-square-check'> </i>{% else %}<i class='fa-regular fa-square'> </i>{% endif %}
          {% endfor %}
              <i class='fa-regular fa-skull'> </i>
            </td></tr>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class='row'>
    <div class='col-12'>
      <div class='row'>
        <div class='col-12 col-md-6'>
          <div class='card skills' id='card-skills'>
            <div class='card-body of'>
              <table class='table'>
                {% for i in 1..5 %}
                  {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
                  {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                  {% set sk = attribute(variables, 'sk_value_' ~ id)|default %}
                  {% if sk >= 0 %}{% set sk = '+' ~ sk %}{% endif %}
                  <tr>
                    <th class='lbl {{eo}} lbl-sk-value'><label for='sk_value'>{{skill_list[id-1][0]}}</label></th>
                    <th class='lbl {{eo}} lbl-sk-value r' width='70px'>{{skill_list[id-1][1]|default|upper}} {{ attribute(_context, skill_list[id-1][1]|default)|default }}</th>
                    <td class='var {{eo}} var-sk-value c' width='70px'>{{sk}}</td>
                  </tr>
                {% endfor %}
              </table>
            </div>
          </div>
        </div>
        <div class='col-12 col-md-6'>
          <div class='card skills' id='card-skills'>
            <div class='card-body of'>
              <table class='table'>
                {% for i in 6..10 %}
                  {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
                  {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                  {% set sk = attribute(variables, 'sk_value_' ~ id)|default %}
                  {% if sk >= 0 %}{% set sk = '+' ~ sk %}{% endif %}
                  <tr>
                    <th class='lbl {{eo}} lbl-sk-value'><label for='sk_value'>{{skill_list[id-1][0]}}</label></th>
                    <th class='lbl {{eo}} lbl-sk-value r' width='70px'>{{skill_list[id-1][1]|default|upper}} {{ attribute(_context, skill_list[id-1][1]|default)|default }}</th>
                    <td class='var {{eo}} var-sk-value c' width='70px'>{{sk}}</td>
                  </tr>
                {% endfor %}
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class='row'>
    {% for i in 1..4 %}
    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}{% if id < 100 %}{% set id = '0' ~ id %}{% endif %}
    {% set feature = attribute(variables, 'features_' ~ id)|default|nl2br %}
    {% if feature != "" %}
    <div class='col-12 col-md-6'>
      <div class='card features' id='card-features'>
        <div class='card-body of pd'>
            <div class='var var-features'> {{feature}} </div>
        </div>
      </div>
    </div>
    {% endif %}
    {% endfor %}
    {% if variables.notes|default != "" %}
    <div class='col-12 col-md-12'>
      <div class='card notes' id='card-notes'>
        <div class='card-header notes'>Notes</div>
        <div class='card-body of'>
          <div class='var od var-notes'> {{variables.notes|default|nl2br}} </div>
        </div>
      </div>
    </div>
    {% endif %}
  </div>
    <div class='row do-not-print'>
      <div class='col-12 c small'>
        <br>
        <a href="https://nimblerpg.com/" target="_new">Nimble &copy; 2025 Nimble Co.</a> - Sheet made by <a href="/w/sheet-creation/board/nimble" target="_new">Tillerz - v1.00, Updated: 2026-09-05</a><br>
      </div>
    </div>
</div>