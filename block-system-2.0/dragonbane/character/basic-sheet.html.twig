                        <tr><th class='lbl ev lbl-helmet-bane-bows'> {{ tr[lang]['bows'] }} </th><td class='var {{eo}} var-helmet-bane-bows c'>{% if variables.helmet_bane_bows|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card misc" id="card-misc">
                <div class="card-body">
                    <table class='table'>
                        <tr><th class='lbl od lbl-movement' width='60%'> {{ tr[lang]['movement'] }} </th><td class='var od var-movement c'> {{variables.movement|default}} </td></tr>
                        <tr><th class='lbl ev lbl-dmg-bonus-str'> {{ tr[lang]['dmg bonus str'] }} </th><td class='var ev var-dmg-bonus-str c'> {{variables.dmg_bonus_str|default}} </td></tr>
                        <tr><th class='lbl od lbl-dmg-bonus-agl'> {{ tr[lang]['dmg bonus agl'] }} </th><td class='var od var-dmg-bonus-agl c'> {{variables.dmg_bonus_agl|default}} </td></tr>
                        <tr><th class='lbl lbl-pools' colspan=2> {{ tr[lang]['pools'] }} </th></tr>
                        <tr><th class='lbl ev lbl-wil-points'> {{ tr[lang]['wil points'] }} </th><td class='var ev var-wil-points c'>{{variables.wil_points|default}} / {{variables.wil_points_max|default}}</td></tr>
                        <tr><th class='lbl od lbl-hit-points'> {{ tr[lang]['hit points'] }} </th><td class='var od var-hit-points c'>{{variables.hit_points|default}} / {{variables.hit_points_max|default}}</td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card belongings" id="card-belongings">
                <div class="card-body">
                    <table class='table'>
                        <tr><th class='lbl' colspan=2> {{ tr[lang]['coins'] }} </th></tr>
                        <tr><th class='lbl od lbl-gold' width='40%'> {{ tr[lang]['gold'] }} </th><td class='var od var-gold c'>{{variables.gold|default}}</td></tr>
                        <tr><th class='lbl ev lbl-silver'> {{ tr[lang]['silver'] }} </th><td class='var ev var-silver c'>{{variables.silver|default}}</td></tr>
                        <tr><th class='lbl od lbl-copper'> {{ tr[lang]['copper'] }} </th><td class='var od var-copper c'>{{variables.copper|default}}</td></tr>
                        <tr><th class='lbl ev lbl-memento' colspan=2> {{ tr[lang]['memento'] }} </th></tr>
                        <tr><td class='var ev var-memento' colspan=2> {{variables.memento|default|nl2br}} </td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card belongings" id="card-belongings">
                <div class="card-body">
                    <table class='table'>
                        <tr><th class='lbl lbl-tiny-items' colspan=2> {{ tr[lang]['tiny items'] }} </th></tr>
                        <tr><td class='var ev var-tiny-items' colspan=2> {{variables.tiny_items|default|nl2br}} </td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card belongings" id="card-belongings">
                <div class="card-body">
                    <table class='table'>
                        <tr><th class='lbl' colspan=2> {{ tr[lang]['equipment'] }} </th></tr>
                        <tr><th class='lbl ev lbl-enc-limit' width='60%'> {{ tr[lang]['encumbrance limit'] }} </th><td class='var ev var-enc-limit c'> {{variables.enc_limit|default}} </td></tr>
                        <tr><td class='var ev var-equipment' colspan=2> {% if variables.backpack|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %} {{ tr[lang]['backpack'] }} </td></tr>
                        {% for i in 1..10 %}
                            {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                            {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                            {% set item = attribute(variables, 'equipment_' ~ id)|default %}
                            {% if item != "" %}
                            <tr><td class='var {{eo}} var-equipment' colspan=2> {{item}} </td></tr>
                            {% endif %}
                        {% endfor %}
                    </table>
                </div>
            </div>
        </div>
    </div>
