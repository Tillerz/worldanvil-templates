<div class="container-fluid sheet-dragonbane">
    <button title="Minimize header section" class="minimize btn btn-link collapsed" data-toggle="collapse" data-target="#collapseBackground" aria-expanded="true" aria-controls="collapseBackground"><em class="fas fa-angle-down"></em></button>
    <div class="row collapse show" id="collapseBackground">
        <div class="col-12 col-md-12 col-lg-8">
            <div class="row">
                <div class="col-12 hidden-xs hidden-sm hidden-md d-none d-lg-block">
                    <div class="logo"></div>
                </div>
                <div class="col-12 col-md-12">
                    <div class="card personal" id="card-personal">
                        <div class="card-body">
                            <table class='table'>
                                <tr><th class='lbl lbl-name' width='30%'> {{ tr[lang]['name'] }} </th><td class='var var-name'> {{variables.name|default}} </td></tr>
                                <tr><th class='lbl lbl-player'> {{ tr[lang]['player'] }} </th><td class='var var-player'> {{variables.player|default}} </td></tr>
                                <tr><th class='lbl lbl-kin'> {{ tr[lang]['kin'] }} </th><td class='var var-kin'> {{variables.kin|default}} </td></tr>
                                <tr><th class='lbl lbl-age'> {{ tr[lang]['age'] }} </th><td class='var var-age'> {{variables.age|default}} </td></tr>
                                <tr><th class='lbl lbl-profession'> {{ tr[lang]['profession'] }} </th><td class='var var-profession'> {{variables.profession|default}} </td></tr>
                                <tr><th class='lbl lbl-weakness'> {{ tr[lang]['weakness'] }} </th><td class='var var-weakness'> {{variables.weakness|default}} </td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="card appearance" id="card-appearance">
                        <div class="card-body">
                            <div class='cContainer'><div class='lbl lbl-appearance'> {{ tr[lang]['appearance'] }} </div><div class='var var-appearance'> {{variables.appearance|default|nl2br}} </div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4 hidden-xs hidden-sm hidden-md d-none d-lg-block">
            <div class="card portrait" id="card-portrait">
                <div class="card-body">
                    <div class='cContainer'><div class='lbl lbl-imageid'> {{ tr[lang]['portrait'] }} </div><div class='var var-imageid'>[img:{{variables.imageid|default}}]</div></div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="row">
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='lbl att lbl-att-str' title='{{ tr[lang]['strength'] }}'> {{ tr[lang]['STR'] }} </div><div class='var att var-att-str'> {{variables.att_str|default}} </div></div>
                            <div class='cContainer'><div class='lbl cond lbl-cond-exhausted'>{% if variables.cond_exhausted|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %} {{ tr[lang]['exhausted'] }} </div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='lbl att lbl-att-con' title='{{ tr[lang]['constitution'] }}'> {{ tr[lang]['CON'] }} </div><div class='var att var-att-con'> {{variables.att_con|default}} </div></div>
                            <div class='cContainer'><div class='lbl cond lbl-cond-sickly'>{% if variables.cond_sickly|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %} {{ tr[lang]['sickly'] }} </div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='lbl att lbl-att-agl' title='{{ tr[lang]['agility'] }}'> {{ tr[lang]['AGL'] }} </div><div class='var att var-att-agl'> {{variables.att_agl|default}} </div></div>
                            <div class='cContainer'><div class='lbl cond lbl-cond-dazed'>{% if variables.cond_dazed|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %} {{ tr[lang]['dazed'] }} </div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='lbl att lbl-att-int' title='{{ tr[lang]['intelligence'] }}'> {{ tr[lang]['INT'] }} </div><div class='var att var-att-int'> {{variables.att_int|default}} </div></div>
                            <div class='cContainer'><div class='lbl cond lbl-cond-angry'>{% if variables.cond_angry|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %} {{ tr[lang]['angry'] }} </div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='lbl att lbl-att-wil' title='{{ tr[lang]['willpower'] }}'> {{ tr[lang]['WIL'] }} </div><div class='var att var-att-wil'> {{variables.att_wil|default}} </div></div>
                            <div class='cContainer'><div class='lbl cond lbl-cond-scared'>{% if variables.cond_scared|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %} {{ tr[lang]['scared'] }} </div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='lbl att lbl-att-cha' title='{{ tr[lang]['charisma'] }}'> {{ tr[lang]['CHA'] }} </div><div class='var att var-att-cha'> {{variables.att_cha|default}} </div></div>
                            <div class='cContainer'><div class='lbl cond lbl-cond-disheartened'>{% if variables.cond_disheartened|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %} {{ tr[lang]['disheartened'] }} </div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card skills" id="card-skills">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-md-6 col-lg-3">
                            <table class='table'>
                                <tr>
                                    <th class='lbl {{eo}} lbl-skill-check' title='{{ tr[lang]['learned skill'] }}'> {{ tr[lang]['l'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-value c'> {{ tr[lang]['value'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-name'> {{ tr[lang]['skill'] }} </th>
                                </tr>
                                {% for i in 1..10 %}
                                    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                                    {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                                    {% set em = ''%}
                                <tr>
                                    <td class='var {{eo}} var-skill-check'>{% if attribute(variables, 'skill_check_' ~ id)|default|default == 1 %}{% set em = 'em' %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td>
                                    <td class='var {{eo}} var-skill-value r {{em}}'> {{attribute(variables, 'skill_value_' ~ id)|default}} </td>
                                    <td class='var {{eo}} var-skill-name {{em}}'> {{ skills[lang][id*2-2]|default }} ({{ skills[lang][id*2-1]|default|upper }})</td>
                                </tr>
                                {% endfor %}
                            </table>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <table class='table'>
                                <tr>
                                    <th class='lbl {{eo}} lbl-skill-check' title='{{ tr[lang]['learned skill'] }}'> {{ tr[lang]['l'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-value c'> {{ tr[lang]['value'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-name'> {{ tr[lang]['skill'] }} </th>
                                </tr>
                                {% for i in 11..20 %}
                                    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                                    {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                                    {% set em = ''%}
                                <tr>
                                    <td class='var {{eo}} var-skill-check c'>{% if attribute(variables, 'skill_check_' ~ id)|default|default == 1 %}{% set em = 'em' %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td>
                                    <td class='var {{eo}} var-skill-value r {{em}}'> {{attribute(variables, 'skill_value_' ~ id)|default}} </td>
                                    <td class='var {{eo}} var-skill-name {{em}}'> {{ skills[lang][id*2-2]|default }} ({{ skills[lang][id*2-1]|default|upper }})</td>
                                </tr>
                                {% endfor %}
                            </table>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <table class='table'>
                                <tr>
                                    <th class='lbl {{eo}} lbl-skill-check c' title='{{ tr[lang]['learned skill'] }}'> {{ tr[lang]['l'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-value c'> {{ tr[lang]['value'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-name'> {{ tr[lang]['weapon skill'] }} </th>
                                </tr>
                                <tr>
                                {% for i in 1..10 %}
                                    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                                    {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                                    {% set em = ''%}
                                <tr>
                                    <td class='var {{eo}} var-skill-check c'>{% if attribute(variables, 'weapon_skill_check_' ~ id)|default|default == 1 %}{% set em = 'em' %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td>
                                    <td class='var {{eo}} var-skill-value r {{em}}'> {{attribute(variables, 'weapon_skill_value_' ~ id)|default}} </td>
                                    <td class='var {{eo}} var-skill-name {{em}}'> {{ weapon_skills[lang][id*2-2]|default }} ({{ weapon_skills[lang][id*2-1]|default|upper }})</td>
                                </tr>
                                {% endfor %}
                            </table>
                        </div>
                        <div class="col-12 col-md-6 col-lg-3">
                            <table class='table'>
                                <tr>
                                    <th class='lbl {{eo}} lbl-skill-check' title='learned skill'> {{ tr[lang]['l'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-value c'> {{ tr[lang]['value'] }} </th>
                                    <th class='lbl {{eo}} lbl-skill-name'> {{ tr[lang]['secondary skill'] }} </th>
                                </tr>
                                <tr>
                                {% for i in 1..10 %}
                                    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                                    {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                                    {% set em = ''%}
                                    {% set name = attribute(variables, 'sec_skill_name_' ~ id)|default %}
                                    {% if name != "" %}
                                <tr>
                                    <td class='var {{eo}} var-skill-check'>{% if attribute(variables, 'sec_skill_check_' ~ id)|default|default == 1 %}{% set em = 'em' %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td>
                                    <td class='var {{eo}} var-skill-value r {{em}}'> {{attribute(variables, 'sec_skill_value_' ~ id)|default}} </td>
                                    <td class='var {{eo}} var-skill-name {{em}}'> {{name}} ({{attribute(variables, 'sec_skill_att_' ~ id)|default|upper}})</td>
                                </tr>
                                    {% endif %}
                                {% endfor %}
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12 col-md-12 col-lg-6">
            <div class="card weapons" id="card-weapons">
                <div class="card-body of">
                    <table class='table'>
                        <tr>
                            <th class='lbl lbl-weapon-name'> {{ tr[lang]['weapon name'] }} </th>
                            <th class='lbl lbl-weapon-grip'> {{ tr[lang]['grip'] }} </th>
                            <th class='lbl lbl-weapon-range' title='Range'> {{ tr[lang]['rng'] }} </th>
                            <th class='lbl lbl-weapon-damage' title='Damage'> {{ tr[lang]['dmg'] }} </th>
                            <th class='lbl lbl-weapon-durability' title='Durability'> {{ tr[lang]['dur'] }} </th>
                            <th class='lbl lbl-weapon-features'> {{ tr[lang]['features'] }} </th>
                        </tr>
                        {% for i in 1..3 %}
                            {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                            {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                            {% set name = attribute(variables, 'weapon_name_' ~ id)|default %}
                            {% if name != "" %}
                        <tr>
                            <td class='var {{eo}} var-weapon-name'> {{name}} </td>
                            <td class='var {{eo}} var-weapon-grip c'> {{attribute(variables, 'weapon_grip_' ~ id)|default}} </td>
                            <td class='var {{eo}} var-weapon-range c'> {{attribute(variables, 'weapon_range_' ~ id)|default}} </td>
                            {% set dmg = '[roll:' ~ attribute(variables, 'weapon_damage_' ~ id)|default ~ ']' %}
                            <td class='var {{eo}} var-weapon-damage c'> {{dmg}} </td>
                            <td class='var {{eo}} var-weapon-durability c'> {{attribute(variables, 'weapon_durability_' ~ id)|default}} </td>
                            <td class='var {{eo}} var-weapon-features'> {{attribute(variables, 'weapon_features_' ~ id)|default}} </td>
                        </tr>
                            {% endif %}
                        {% endfor %}
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card armor" id="card-armor">
                <div class="card-body">
                    <table class='table'>
                        <tr><th class='lbl lbl-armor' colspan=2> {{ tr[lang]['armor'] }} </th></tr>
                        <tr><th class='lbl od lbl-armor-rating' width='40%'> {{ tr[lang]['rating'] }} </th><td class='var {{eo}} var-armor-rating c'>{{variables.armor_rating|default}}</td></tr>
                        <tr><th class='lbl ev lbl-armor-name'> {{ tr[lang]['armor name'] }} </th><td class='var {{eo}} var-armor-name c'> {{variables.armor_name|default}} </td></tr>
                        <tr><th class='lbl lbl-armor-banes' colspan=2> {{ tr[lang]['banes'] }} </th></tr>
                        <tr><th class='lbl od lbl-armor-bane-acrobatics'> {{ tr[lang]['acrobatics'] }} </th><td class='var {{eo}} var-armor-bane-acrobatics c'>{% if variables.armor_bane_acrobatics|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td></tr>
                        <tr><th class='lbl ev lbl-armor-bane-evade'> {{ tr[lang]['evade'] }} </th><td class='var {{eo}} var-armor-bane-evade c'>{% if variables.armor_bane_evade|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td></tr>
                        <tr><th class='lbl od lbl-armor-bane-sneaking'> {{ tr[lang]['sneaking'] }} </th><td class='var {{eo}} var-armor-bane-sneaking c'>{% if variables.armor_bane_sneaking|default == 1 %}<i class='fa-regular fa-square-check'></i>{% else %}<i class='fa-regular fa-square'></i>{% endif %}</td></tr>
                    </table>
                </div>
            </div>
        </div>
