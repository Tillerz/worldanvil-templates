                            <td class='ivar {{eo}} ivar-weapon-name'><input value='{{attribute(variables, 'weapon_name_' ~ id)|default}}' class='form-control ivar ivar-weapon-name' id='weapon_name_{{id}}' name='weapon_name_{{id}}' type='text' placeholder='eg Broadsword' /></td>
                            <td class='ivar {{eo}} ivar-weapon-grip'><input value='{{attribute(variables, 'weapon_grip_' ~ id)|default}}' class='form-control ivar ivar-weapon-grip c' id='weapon_grip_{{id}}' name='weapon_grip_{{id}}' type='text' placeholder='1H' /></td>
                            <td class='ivar {{eo}} ivar-weapon-range'><input value='{{attribute(variables, 'weapon_range_' ~ id)|default}}' class='form-control ivar ivar-weapon-range c' id='weapon_range_{{id}}' name='weapon_range_{{id}}' type='text' placeholder='10' /></td>
                            <td class='ivar {{eo}} ivar-weapon-damage'><input value='{{attribute(variables, 'weapon_damage_' ~ id)|default}}' class='form-control ivar ivar-weapon-damage c' id='weapon_damage_{{id}}' name='weapon_damage_{{id}}' type='text' placeholder='eg 2d6' /></td>
                            <td class='ivar {{eo}} ivar-weapon-durability'><input value='{{attribute(variables, 'weapon_durability_' ~ id)|default}}' class='form-control ivar ivar-weapon-durability c' id='weapon_durability_{{id}}' name='weapon_durability_{{id}}' type='text' placeholder='15' /></td>
                            <td class='ivar {{eo}} ivar-weapon-features'><input value='{{attribute(variables, 'weapon_features_' ~ id)|default}}' class='form-control ivar ivar-weapon-features' id='weapon_features_{{id}}' name='weapon_features_{{id}}' type='text' placeholder='eg Piercing, slashing' /></td>
                        </tr>
                        {% endfor %}
                    </table>
                </div>
            </div>
        </div>
    </div>
