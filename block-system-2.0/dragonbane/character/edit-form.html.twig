<div class="container-fluid sheet-dragonbane">
    <div class="row">
        <div class="col-12 col-md-6">
            <div class="card personal" id="card-personal">
                <div class="card-body">
                    <table class='table'>
                        <tr><th class='ilbl ilbl-name' width='30%'> {{ tr[lang]['name'] }} </th><td class='ivar od ivar-name'><input value='{{variables.name|default}}' class='form-control ivar ivar-name' id='name' name='name' type='text' required=required /></td></tr>
                        <tr><th class='ilbl ilbl-player'> {{ tr[lang]['player'] }} </th><td class='ivar ev ivar-player'><input value='{{variables.player|default}}' class='form-control ivar ivar-player' id='player' name='player' type='text' /></td></tr>
                        <tr><th class='ilbl ilbl-kin'> {{ tr[lang]['kin'] }} </th><td class='ivar od} ivar-kin'><input value='{{variables.kin|default}}' class='form-control ivar ivar-kin' id='kin' name='kin' type='text' required=required /></td></tr>
                        <tr><th class='ilbl ilbl-age'> {{ tr[lang]['age'] }} </th><td class='ivar ev ivar-age'><input value='{{variables.age|default}}' class='form-control ivar ivar-age' id='age' name='age' type='text' /></td></tr>
                        <tr><th class='ilbl ilbl-profession'> {{ tr[lang]['profession'] }} </th><td class='ivar od ivar-profession'><input value='{{variables.profession|default}}' class='form-control ivar ivar-profession' id='profession' name='profession' type='text' required=required /></td></tr>
                        <tr><th class='ilbl ilbl-weakness'> {{ tr[lang]['weakness'] }} </th><td class='ivar ev ivar-weakness'><input value='{{variables.weakness|default}}' class='form-control ivar ivar-weakness' id='weakness' name='weakness' type='text' /></td></tr>
                        <tr><th class='ilbl ilbl-imageid'> {{ tr[lang]['portrait'] }} </th><td class='ivar od ivar-imageid'><input value='{{variables.imageid|default}}' class='form-control ivar ivar-imageid' id='imageid' name='imageid' type='number' placeholder='WA image id' /></td></tr>
                        <tr><th class='ilbl ilbl-lang'>{{ tr[lang]['sheet language'] }}</th><td class='ivar od ivar-lang'>
                            <select  class='form-control ivar ivar-lang' id='lang' name='lang'>
                                <option value='en' {% if variables.lang|default('en') == 'en' %}selected='selected' {% endif %} > english </option>
                                <option value='de' {% if variables.lang|default('de') == 'de' %}selected='selected' {% endif %} > deutsch </option>
                            </select>
                        </td></tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6">
            <div class="card appearance" id="card-appearance">
                <div class="card-body">
                    <div class='cContainer'><div class='ilbl ilbl-appearance'> {{ tr[lang]['appearance'] }} </div><div class='ivar ivar-appearance'><div class='iContent'><textarea class='form-control ivar ivar-appearance mention' id='appearance' name='appearance' rows='3'  >{{variables.appearance|default}}</textarea></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="row">
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='ilbl att ilbl-att-str'> {{ tr[lang]['STR'] }} </div><div class='ivar att ivar-att-str mb'><input value='{{variables.att_str|default}}' class='form-control ivar ivar-att-str c' id='att_str' name='att_str' type='text' required=required /></div></div>
                            <div class='cContainer'><div class='ilbl cond ilbl-cond-exhausted'> {{ tr[lang]['exhausted'] }} </div><div class='ivar cond ivar-cond-exhausted'><input value='0' id='cond_exhausted' name='cond_exhausted' type='hidden' /><input value='1' {% if variables.cond_exhausted|default > 0 %} checked='checked'{% endif %} id='cond_exhausted' name='cond_exhausted' type='checkbox' /></div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='ilbl att ilbl-att-con'> {{ tr[lang]['CON'] }} </div><div class='ivar att ivar-att-con mb'><input value='{{variables.att_con|default}}' class='form-control ivar ivar-att-con c' id='att_con' name='att_con' type='text' required=required /></div></div>
                            <div class='cContainer'><div class='ilbl cond ilbl-cond-sickly'> {{ tr[lang]['sickly'] }} </div><div class='ivar cond ivar-cond-sickly'><input value='0' id='cond_sickly' name='cond_sickly' type='hidden' /><input value='1' {% if variables.cond_sickly|default > 0 %} checked='checked'{% endif %} id='cond_sickly' name='cond_sickly' type='checkbox' /></div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='ilbl att ilbl-att-agl'> {{ tr[lang]['AGL'] }} </div><div class='ivar att ivar-att-agl mb'><input value='{{variables.att_agl|default}}' class='form-control ivar ivar-att-agl c' id='att_agl' name='att_agl' type='text' required=required /></div></div>
                            <div class='cContainer'><div class='ilbl cond ilbl-cond-dazed'> {{ tr[lang]['dazed'] }} </div><div class='ivar cond ivar-cond-dazed'><input value='0' id='cond_dazed' name='cond_dazed' type='hidden' /><input value='1' {% if variables.cond_dazed|default > 0 %} checked='checked'{% endif %} id='cond_dazed' name='cond_dazed' type='checkbox' /></div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='ilbl att ilbl-att-int'> {{ tr[lang]['INT'] }} </div><div class='ivar att ivar-att-int mb'><input value='{{variables.att_int|default}}' class='form-control ivar ivar-att-int c' id='att_int' name='att_int' type='text' required=required /></div></div>
                            <div class='cContainer'><div class='ilbl cond ilbl-cond-angry'> {{ tr[lang]['angry'] }} </div><div class='ivar cond ivar-cond-angry'><input value='0' id='cond_angry' name='cond_angry' type='hidden' /><input value='1' {% if variables.cond_angry|default > 0 %} checked='checked'{% endif %} id='cond_angry' name='cond_angry' type='checkbox' /></div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='ilbl att ilbl-att-wil'> {{ tr[lang]['WIL'] }} </div><div class='ivar att ivar-att-wil mb'><input value='{{variables.att_wil|default}}' class='form-control ivar ivar-att-wil c' id='att_wil' name='att_wil' type='text' required=required /></div></div>
                            <div class='cContainer'><div class='ilbl cond ilbl-cond-scared'> {{ tr[lang]['scared'] }} </div><div class='ivar cond ivar-cond-scared'><input value='0' id='cond_scared' name='cond_scared' type='hidden' /><input value='1' {% if variables.cond_scared|default > 0 %} checked='checked'{% endif %} id='cond_scared' name='cond_scared' type='checkbox' /></div></div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <div class="card attributes" id="card-attributes">
                        <div class="card-body">
                            <div class='cContainer'><div class='ilbl att ilbl-att-cha'> {{ tr[lang]['CHA'] }} </div><div class='ivar att ivar-att-cha mb'><input value='{{variables.att_cha|default}}' class='form-control ivar ivar-att-cha c' id='att_cha' name='att_cha' type='text' required=required /></div></div>
                            <div class='cContainer'><div class='ilbl cond ilbl-cond-disheartened'> {{ tr[lang]['disheartened'] }} </div><div class='ivar cond ivar-cond-disheartened'><input value='0' id='cond_disheartened' name='cond_disheartened' type='hidden' /><input value='1' {% if variables.cond_disheartened|default > 0 %} checked='checked'{% endif %} id='cond_disheartened' name='cond_disheartened' type='checkbox' /></div></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card skills" id="card-skills">
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-md-6">
                            <table class='table'>
                                <tr>
                                    <th class='ilbl {{eo}} ilbl-skill-check c' width='20px' title='learned skill'> {{ tr[lang]['l'] }} </th>
                                    <th class='ilbl {{eo}} ilbl-skill-value c'> {{ tr[lang]['value'] }} </th>
                                    <th class='ilbl {{eo}} ilbl-skill-name'> {{ tr[lang]['skill'] }} </th>
                                </tr>
                                {% for i in 1..20 %}
                                    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                                    {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                                <tr>
                                    <td class='ivar {{eo}} ivar-skill-check'><input value='0' id='skill_check_{{id}}' name='skill_check_{{id}}' type='hidden' /><input class='form-control ivar ivar-skill-check' value='1' {% if attribute(variables, 'skill_check_' ~ id)|default > 0 %} checked='checked'{% endif %} id='skill_check_{{id}}' name='skill_check_{{id}}' type='checkbox' /></td>
                                    <td class='ivar {{eo}} ivar-skill-value'><input value='{{attribute(variables, 'skill_value_' ~ id)|default}}' class='form-control ivar ivar-skill-value c' id='skill_value_{{id}}' name='skill_value_{{id}}' type='text' /></td>
                                    <td class='ivar {{eo}} ivar-skill-name'> {{ skills[lang][id*2-2]|default }} ({{ skills[lang][id*2-1]|default|upper }})</td>
                                </tr>
                                {% endfor %}
                            </table>
                        </div>
                        <div class="col-12 col-md-6">
                            <table class='table'>
                                <tr>
                                    <th class='ilbl {{eo}} ilbl-skill-check c' width='20px' title='learned skill'> {{ tr[lang]['l'] }} </th>
                                    <th class='ilbl {{eo}} ilbl-skill-value c'> {{ tr[lang]['value'] }} </th>
                                    <th class='ilbl {{eo}} ilbl-skill-name'> {{ tr[lang]['weapon skill'] }} </th>
                                </tr>
                                {% for i in 1..10 %}
                                    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                                    {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                                <tr>
                                    <td class='ivar {{eo}} ivar-weapon-skill-check'><input value='0' id='weapon_skill_check_{{id}}' name='weapon_skill_check_{{id}}' type='hidden' /><input class='form-control ivar ivar-skill-check' value='1' {% if attribute(variables, 'weapon_skill_check_' ~ id)|default > 0 %} checked='checked'{% endif %} id='weapon_skill_check_{{id}}' name='weapon_skill_check_{{id}}' type='checkbox' /></td>
                                    <td class='ivar {{eo}} ivar-weapon-skill-value'><input value='{{attribute(variables, 'weapon_skill_value_' ~ id)|default}}' class='form-control ivar ivar-weapon-skill-value c' id='weapon_skill_value_{{id}}' name='weapon_skill_value_{{id}}' type='text' /></td>
                                    <td class='var {{eo}} var-skill-name'> {{ weapon_skills[lang][id*2-2]|default }} ({{ weapon_skills[lang][id*2-1]|default|upper }})</td>
                                </tr>
                                {% endfor %}
                            </table>
                            <table class='table'>
                                <tr>
                                    <th class='ilbl {{eo}} ilbl-skill-check c' width='20px' title='learned skill'> {{ tr[lang]['l'] }} </th>
                                    <th class='ilbl {{eo}} ilbl-skill-value c'> {{ tr[lang]['value'] }} </th>
                                    <th class='ilbl {{eo}} ilbl-skill-name'> {{ tr[lang]['secondary skill'] }} </th>
                                    <th class='ilbl {{eo}} ilbl-skill-attr c' width='100px' title='{{ tr[lang]['attribute'] }}'> {{ tr[lang]['att'] }} </th>
                                </tr>
                                {% for i in 1..10 %}
                                    {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                                    {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
                                    {% set name = attribute(variables, 'sec_skill_name_' ~ id)|default %}
                                <tr>
                                    <td class='ivar {{eo}} ivar-sec-skill-check'><input value='0' id='sec_skill_check_{{id}}' name='sec_skill_check_{{id}}' type='hidden' /><input class='form-control ivar ivar-skill-check' value='1' {% if attribute(variables, 'sec_skill_check_' ~ id)|default > 0 %} checked='checked'{% endif %} id='sec_skill_check_{{id}}' name='sec_skill_check_{{id}}' type='checkbox' /></td>
                                    <td class='ivar {{eo}} ivar-sec-skill-value'><input value='{{attribute(variables, 'sec_skill_value_' ~ id)|default}}' class='form-control ivar ivar-sec-skill-value c' id='sec_skill_value_{{id}}' name='sec_skill_value_{{id}}' type='text' /></td>
                                    <td class='ivar {{eo}} ivar-sec-skill-name'><input value='{{attribute(variables, 'sec_skill_name_' ~ id)|default}}' class='form-control ivar ivar-sec-skill-name' id='sec_skill_name_{{id}}' name='sec_skill_name_{{id}}' type='text' /></td>
                                    <td class='ivar {{eo}} ivar-sec-skill-att'>
                                    <select  class='form-control ivar ivar-sec-skill-att' id='sec_skill_att_{{id}}' name='sec_skill_att_{{id}}'>
                                        <option value='int' {% if attribute(variables, 'sec_skill_att_' ~ id)|default == 'int' %}selected='selected' {% endif %} > {{ tr[lang]['INT'] }} </option>
                                        <option value='agl' {% if attribute(variables, 'sec_skill_att_' ~ id)|default == 'agl' %}selected='selected' {% endif %} > {{ tr[lang]['AGL'] }} </option>
                                        <option value='cha' {% if attribute(variables, 'sec_skill_att_' ~ id)|default == 'cha' %}selected='selected' {% endif %} > {{ tr[lang]['CHA'] }} </option>
                                        <option value='str' {% if attribute(variables, 'sec_skill_att_' ~ id)|default == 'str' %}selected='selected' {% endif %} > {{ tr[lang]['STR'] }} </option>
                                    </select></td>
                                </tr>
                                {% endfor %}
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="card weapons" id="card-weapons">
                <div class="card-body">
                    <table class='table'>
                        <tr>
                            <th class='ilbl {{eo}} ilbl-weapon-name'> {{ tr[lang]['name'] }} </th>
                            <th class='ilbl {{eo}} ilbl-weapon-grip c' width='70px'> {{ tr[lang]['grip'] }} </th>
                            <th class='ilbl {{eo}} ilbl-weapon-range c' width='100px'> {{ tr[lang]['rng'] }} </th>
                            <th class='ilbl {{eo}} ilbl-weapon-damage c' width='100px'> {{ tr[lang]['dmg'] }} </th>
                            <th class='ilbl {{eo}} ilbl-weapon-durability c' width='70px'> {{ tr[lang]['dur'] }} </th>
                            <th class='ilbl {{eo}} ilbl-weapon-features'> {{ tr[lang]['features'] }} </th>
                        </tr>
                        {% for i in 1..3 %}
                            {% set id = i %}{% if id < 10 %}{% set id = '0' ~ id %}{% endif %}
                            {% set eo = 'od' %}{% if id is even %}{% set eo = 'ev' %}{% endif %}
